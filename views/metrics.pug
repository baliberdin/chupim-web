extends layout
include includes/empty-state

block main
  main(class="flex min-h-0 flex-1")
    aside(class="flex w-72 shrink-0 flex-col border-r border-zinc-200 bg-white" aria-labelledby="monitor-heading")
      div(class="border-b border-zinc-200 p-4")
        h1#monitor-heading(class="text-lg font-semibold tracking-tight") Metrics
        p(class="mt-1 text-xs text-zinc-500") Pick resources and stages to chart. Data covers the last 30 minutes and refreshes every 10 seconds.
        label(class="relative mt-3 block")
          span(class="sr-only") Search
          span(class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-zinc-400")!= icon('search')
          input(type="search" class="input pl-8" placeholder="Search" data-stage-search)

      div(class="flex-1 overflow-y-auto p-3")
        div(data-stage-group)
          div(class="px-2 py-1 text-xs font-semibold tracking-wide text-zinc-500 uppercase") Resources
          if resources.length == 0
            p(class="px-2 py-1 text-sm text-zinc-400") No resources
          each r in resources
            label(class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-zinc-700 hover:bg-zinc-100" data-stage-item data-search=`${r.name} ${r.id}`.toLowerCase())
              input(type="checkbox" class="size-4 rounded accent-brand-600" data-metric=`/api/${r.id}` data-metric-type="resource" data-metric-label=r.name)
              span(class="truncate")= r.name

        each g in stageGroups
          div(class="mt-3" data-stage-group)
            div(class="flex items-center gap-2 px-2 py-1 text-xs font-semibold tracking-wide text-zinc-500 uppercase")
              span(class="size-2 rounded-full" style=`background:${prefixColor(g.prefix)}`)
              = g.prefix
            each s in g.stages
              label(class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm text-zinc-700 hover:bg-zinc-100" data-stage-item data-search=`${g.prefix} ${s}`.toLowerCase())
                input(type="checkbox" class="size-4 rounded accent-brand-600" data-metric=`${g.prefix}.${s}` data-metric-type="stage" data-metric-label=`${g.prefix} / ${s}`)
                span(class="truncate")= s
        p(class="hidden px-2 py-6 text-center text-sm text-zinc-500" data-stage-empty) Nothing found.

    section(class="min-w-0 flex-1 overflow-y-auto p-6" aria-label="Charts")
      div(class="mb-4 flex items-center justify-between")
        h2(class="text-sm font-medium text-zinc-500") Selected
          span(class="ml-1 text-zinc-900" data-selected-count) 0
        span(class="text-xs text-zinc-400" data-updated-at)

      div(class="card" data-charts-empty)
        +emptyState('chart-line', 'Nothing selected', 'Select resources or stages on the left to see requests, errors, circuit breaks and response time.')

      div(class="grid gap-6 xl:grid-cols-2" data-charts)

  template#chart-template
    article(class="card flex flex-col")
      header(class="flex items-center gap-2 border-b border-zinc-200 px-4 py-3")
        span(class="badge bg-brand-50 text-brand-700" data-chart-type)
        h3(class="min-w-0 flex-1 truncate text-sm font-semibold" data-chart-title)
        button(type="button" class="btn-icon" aria-label="Remove chart" title="Remove" data-chart-remove)!= icon('x')
      div(class="relative h-64 p-4")
        canvas

block scripts
  script(type="module" src="/build/metrics.js")
