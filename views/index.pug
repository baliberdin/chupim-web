extends layout
include includes/empty-state

block content
  div(class="flex flex-wrap items-end justify-between gap-4")
    div
      h1(class="text-2xl font-semibold tracking-tight") Resources
      p(class="mt-1 text-sm text-zinc-500")
        | Pipelines exposed as HTTP endpoints under 
        code(class="rounded bg-zinc-100 px-1 py-0.5 text-xs") /api
        | .

  dl(class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4")
    - const statItems = [['Resources', stats.resources, 'workflow', null], ['Enabled', stats.enabled, 'circle-check', null], ['Stages', stats.stages, 'square-function', null], ['Logged errors', stats.errors, 'triangle-alert', '/errors']]
    each s in statItems
      div(class="card flex items-center gap-4 p-4")
        span(class="flex size-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600")!= icon(s[2], 'size-5')
        div
          dt(class="text-sm text-zinc-500")
            if s[3]
              a(href=s[3] class="hover:text-zinc-900 hover:underline")= s[0]
            else
              = s[0]
          dd(class="text-xl font-semibold tabular-nums")= s[1]

  div(class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]")
    section(class="card overflow-hidden" aria-labelledby="resources-heading")
      h2#resources-heading(class="sr-only") Resource list
      if resources.length == 0
        +emptyState('workflow', 'No resources yet', 'A resource is a pipeline of stages published as an API endpoint.')
          if editable
            a(href="/pipeline/new" class="btn btn-primary")
              != icon('plus')
              | Create your first pipeline
      else
        div(class="overflow-x-auto")
          table(class="w-full text-left text-sm")
            thead(class="border-b border-zinc-200 bg-zinc-50 text-xs font-medium tracking-wide whitespace-nowrap text-zinc-500 uppercase")
              tr
                th(class="px-4 py-3" scope="col") Enabled
                th(class="px-4 py-3" scope="col") Resource
                th(class="px-4 py-3 text-right" scope="col" title="Requests per minute, last 30 minutes") RPM
                th(class="px-4 py-3 text-right" scope="col" title="Average response time") Avg. time
                th(class="px-4 py-3 text-right" scope="col" title="Error rate, last 30 minutes") Errors
                th(class="px-4 py-3" scope="col")
                  span(class="sr-only") Actions
            tbody(class="divide-y divide-zinc-100")
              each r in resources
                tr(class="hover:bg-zinc-50/60")
                  td(class="px-4 py-3")
                    input(type="checkbox" class="switch" data-toggle-resource=r.id checked=r.enabled disabled=!editable aria-label=`Enable ${r.name}`)
                  td(class="px-4 py-3")
                    div(class="font-medium text-zinc-900")= r.name
                    div(class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1")
                      a(href=`/api/${r.id}` target="_blank" class="group inline-flex items-center gap-1 font-mono text-xs text-brand-700 hover:underline")
                        = `/api/${r.id}`
                        != icon('external-link', 'size-3 opacity-0 transition-opacity group-hover:opacity-100')
                      span(class="flex gap-1")
                        each m in r.methods
                          span(class="badge bg-zinc-100 px-1.5 font-mono text-[10px] text-zinc-600")= m
                  td(class="px-4 py-3 text-right whitespace-nowrap tabular-nums text-zinc-700")= r.rpm
                  td(class="px-4 py-3 text-right whitespace-nowrap tabular-nums text-zinc-700")= r.responseTime
                  td(class="px-4 py-3 text-right")
                    if r.errorsPercent <= 0
                      span(class="text-zinc-400") —
                    else if r.errorsPercent <= 2
                      span(class="badge bg-amber-50 text-amber-700 ring-1 ring-amber-200")= `${r.errorsPercent}%`
                    else
                      span(class="badge bg-red-50 text-red-700 ring-1 ring-red-200")= `${r.errorsPercent}%`
                  td(class="px-4 py-3")
                    div(class="flex justify-end gap-1")
                      a(href=`/pipeline/edit/${r.id}` class="btn-icon" title=editable ? 'Edit pipeline' : 'View pipeline' aria-label=`${editable ? 'Edit' : 'View'} ${r.name}`)!= icon(editable ? 'pencil' : 'eye')
                      if editable
                        button(type="button" class="btn-icon hover:bg-red-50 hover:text-red-600" title="Delete" aria-label=`Delete ${r.name}` data-delete-resource=r.id data-name=r.name)!= icon('trash-2')

    aside(class="card" aria-labelledby="stages-heading")
      div(class="flex items-center justify-between border-b border-zinc-200 px-4 py-3")
        h2#stages-heading(class="text-sm font-semibold") Stages
        if editable
          a(href="/stage/new" class="btn-icon" title="New stage" aria-label="New stage")!= icon('plus')
      if stageGroups.length == 0
        +emptyState('square-function', 'No stages yet', 'Stages are the async functions that pipelines are made of.')
      else
        div(class="p-3")
          label(class="relative block")
            span(class="sr-only") Search stages
            span(class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-zinc-400")!= icon('search')
            input(type="search" class="input pl-8" placeholder="Search stages" data-stage-search)
        nav(class="max-h-[32rem] overflow-y-auto px-3 pb-3" aria-label="Stages")
          each g in stageGroups
            div(class="mt-2 first:mt-0" data-stage-group)
              div(class="flex items-center gap-2 px-2 py-1 text-xs font-semibold tracking-wide text-zinc-500 uppercase")
                span(class="size-2 rounded-full" style=`background:${prefixColor(g.prefix)}`)
                = g.prefix
              ul
                each s in g.stages
                  li(data-stage-item data-search=`${g.prefix} ${s}`.toLowerCase())
                    a(href=`/stage/${encodeURIComponent(g.prefix)}/${encodeURIComponent(s)}` class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900")
                      != icon('square-function', 'size-4 text-zinc-400')
                      = s
          p(class="hidden px-2 py-6 text-center text-sm text-zinc-500" data-stage-empty) No stages found.

block scripts
  script(type="module" src="/build/home.js")
