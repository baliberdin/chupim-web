extends ../layout

block main
  - const cb = draft.circuitbreaker || {}
  - const cbEnabled = cb.enabled == true
  - const cbAction = cb.action == 1 ? 1 : 0
  - const readOnly = !editable

  main(class="flex min-h-0 flex-1")
    form#stage-form(method="post" action="/stage" class="flex min-h-0 flex-1" novalidate)
      input(type="hidden" name="editing" value=String(editing))

      aside(class="flex w-96 shrink-0 flex-col border-r border-zinc-200 bg-white")
        div(class="border-b border-zinc-200 p-4")
          a(href="/" class="inline-flex items-center gap-1 text-xs font-medium text-zinc-500 hover:text-zinc-900")
            != icon('arrow-left', 'size-3')
            | Resources
          h1(class="mt-2 text-lg font-semibold tracking-tight")= editing ? 'Edit Stage' : 'New Stage'
          p(class="mt-1 text-xs text-zinc-500") A stage is an async function that receives the pipeline context and returns it.

        div(class="flex-1 space-y-6 overflow-y-auto p-4")
          if formError
            div(class="flex gap-2 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert")
              != icon('triangle-alert', 'mt-0.5 size-4 shrink-0')
              div
                p(class="font-medium") The stage could not be saved
                p(class="mt-1 font-mono text-xs break-words")= formError

          fieldset(class="space-y-4" disabled=readOnly)
            legend(class="text-sm font-semibold text-zinc-900") Identification
            div
              label(class="label" for="stage-prefix") Prefix
              input#stage-prefix(class="input" name="prefix" value=draft.prefix placeholder="e.g. Catalog" list="stage-prefixes" required autocomplete="off")
              datalist#stage-prefixes
                each p in prefixes
                  option(value=p)
              p(class="field-error" data-error-for="stage-prefix") Prefix is required.
              p(class="hint") Groups related stages, like a package name.
            div
              label(class="label" for="stage-name") Name
              input#stage-name(class="input" name="name" value=draft.name placeholder="e.g. searchProducts" required autocomplete="off")
              p(class="field-error" data-error-for="stage-name") Name is required.
            p(class="rounded-md bg-zinc-50 px-3 py-2 text-xs text-zinc-500")
              | Used in pipelines as 
              code(class="font-mono text-zinc-900" data-full-name)= draft.prefix || draft.name ? `${draft.prefix}.${draft.name}` : 'prefix.name'
            if editing && editable
              p(class="flex gap-2 text-xs text-zinc-500")
                != icon('info', 'mt-px size-3.5 shrink-0')
                | Saving with the same prefix and name replaces this stage. A different prefix or name creates a new one.

          fieldset(class="space-y-4" disabled=readOnly)
            div(class="flex items-start justify-between gap-4")
              div
                legend(class="text-sm font-semibold text-zinc-900") Circuit breaker
                p(class="mt-1 text-xs text-zinc-500") Limits how long the stage can take, for stages that call slow or unreliable services.
              input#cb-enabled(type="checkbox" class="switch mt-1" name="circuitBreaker.enabled" value="true" checked=cbEnabled aria-label="Enable circuit breaker")

            div(class="space-y-4" data-cb-options hidden=!cbEnabled)
              div
                label(class="label" for="cb-timeout") Timeout
                div(class="relative")
                  input#cb-timeout(class="input pr-10" name="circuitBreaker.timeout" type="number" min="1" step="1" value=cb.timeout || 1000 required)
                  span(class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs text-zinc-400") ms
                p(class="field-error" data-error-for="cb-timeout") Enter a timeout greater than zero.
              div(role="radiogroup" aria-labelledby="cb-action-label")
                span#cb-action-label(class="label") When it times out or fails
                div(class="grid gap-2")
                  each option in [{value: 0, title: 'Throw an error', text: 'The pipeline fails and the request returns an error.'}, {value: 1, title: 'Run a fallback stage', text: 'Another stage runs in its place and the pipeline goes on.'}]
                    label(class="flex cursor-pointer gap-3 rounded-md border border-zinc-200 p-3 has-checked:border-brand-500 has-checked:bg-brand-50")
                      input(type="radio" class="mt-0.5 accent-brand-600" name="circuitBreaker.action" value=option.value checked=cbAction == option.value)
                      span
                        span(class="block text-sm font-medium")= option.title
                        span(class="block text-xs text-zinc-500")= option.text
              div(data-cb-fallback hidden=cbAction != 1)
                label(class="label" for="cb-fallback") Fallback stage
                select#cb-fallback(class="input" name="circuitBreaker.fn")
                  option(value="") Select a stage
                  each key in fallbackOptions
                    option(value=key selected=cb.fn == key)= key
                p(class="field-error" data-error-for="cb-fallback") Select the stage to run instead.

          details(class="group rounded-md border border-zinc-200")
            summary(class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden")
              != icon('circle-help', 'size-4 text-zinc-400')
              | How to write a stage
              != icon('chevron-down', 'ml-auto size-4 text-zinc-400 transition-transform group-open:rotate-180')
            div(class="space-y-3 border-t border-zinc-200 px-3 py-3 text-xs leading-relaxed text-zinc-600")
              p
                | A stage is a single 
                strong async function
                |  with one parameter, the 
                strong context
                | : an object without fixed structure that carries data through the pipeline and becomes the API response.
              pre(class="overflow-x-auto rounded-md bg-zinc-950 p-3 font-mono text-[11px] text-zinc-100")
                code.
                  async (context) => {
                    const q = context._chupim_.query.q;
                    const res = await fetch(`https://api.example.com/items?q=${q}`);
                    context.items = await res.json();
                    return context;
                  }
              ul(class="list-disc space-y-1 pl-4")
                li Return the context to continue, or throw to fail the pipeline.
                li Keep the context lightweight: it is the API response.
                li Avoid depending on data left by other stages; it couples them.
                li Never block the event loop: use async I/O.

        if editable
          div(class="flex items-center gap-2 border-t border-zinc-200 bg-zinc-50 p-4")
            button(type="submit" class="btn btn-primary")
              != icon('save')
              | Save stage
            a(href="/" class="btn btn-ghost") Cancel
            span(class="ml-auto hidden text-xs text-zinc-400 sm:inline")
              kbd(class="kbd") Ctrl
              |  + 
              kbd(class="kbd") S

      section(class="flex min-w-0 flex-1 flex-col bg-zinc-950")
        div(class="flex h-10 shrink-0 items-center gap-2 border-b border-white/10 px-4 text-xs text-zinc-400")
          != icon('square-function', 'size-4')
          span(class="font-mono text-zinc-200" data-full-name)= draft.prefix || draft.name ? `${draft.prefix}.${draft.name}` : 'untitled'
          span(class="ml-auto") JavaScript · async function
          if !editable
            span(class="badge bg-white/10 text-zinc-300") Read-only
        div(class="min-h-0 flex-1" data-editor)
          label(class="sr-only" for="stage-source") Source code
          textarea#stage-source(name="source" class="h-full w-full resize-none bg-transparent p-4 font-mono text-sm text-zinc-100" spellcheck="false" readonly=readOnly required)= draft.source
        p(class="field-error mt-0 border-t border-red-900 bg-red-950 px-4 py-2 text-red-200" data-error-for="stage-source") The source must be an async function, like async (context) => { ... }

block scripts
  script(type="module" src="/build/stage-editor.js")
