{
  "name": "chupim-web",
  "version": "0.2.0",
  "description": "A Web Pipeline Framework to build APIs",
  "scripts": {
    "start": "node dist/start.js",
    "test": "vitest run",
    "build": "npm run build:server && npm run build:client && npm run build:css",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "esbuild client/pages/*.ts --bundle --format=esm --splitting --minify --sourcemap --target=es2022 --outdir=public/build",
    "build:css": "tailwindcss -i client/styles.css -o public/build/app.css --minify",
    "e2e": "playwright test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chupim": "^0.2.0",
    "compression": "^1.8.2",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "lucide-static": "^1.61.0",
    "morgan": "^1.12.1",
    "pug": "^3.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baliberdin/chupim-web.git"
  },
  "keywords": [
    "Pipeline",
    "BFF",
    "API",
    "microservices"
  ],
  "author": "Allan Baliberdin <a.baliberdin@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/baliberdin/chupim-web/issues"
  },
  "homepage": "https://baliberdin.github.com/chupim-web",
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "chart.js": "^4.6.1",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-edgehandles": "^4.0.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "views",
    "public"
  ]
}
